{
  "description": "The conformance scenarios: every language binding runs exactly these through its own wrapper of the C ABI (or the WASM module) against conformance/mock-server.mjs. See conformance/README.md for the format.",
  "scenarios": [
    {
      "name": "offline-first basics: sync, local reads, a report made offline, votes, errors, close",
      "servers": { "main": {} },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "version", "expect": { "apiVersion": 1 } },
        { "call": "getSyncStatus", "expect": { "connection": "never", "pendingWrites": 0 } },
        { "call": "getSpeedLimitAt", "args": { "lat": 52.0, "lng": 13.005 }, "expect": null },
        { "call": "sync", "expect": { "ok": true, "skipped": false, "pendingWrites": 0 } },
        {
          "call": "getSpeedLimitAt",
          "args": { "lat": 52.0, "lng": 13.005 },
          "expect": { "value": 50, "unit": "kmh", "segmentId": "seg1", "origin": { "kind": "imported" } }
        },
        {
          "call": "getNearby",
          "args": { "lat": 52.0, "lng": 13.0, "radiusMeters": 200, "categories": ["signs"] },
          "expect": { "items": [{ "kind": "sign", "id": "sign1", "signType": "DE:274" }] }
        },
        { "call": "getSyncStatus", "expect": { "connection": "online", "staticDataVersion": 1 } },
        { "call": "submitReport", "args": { "type": "ice", "lat": 52.0, "lng": 13.0 }, "expectKeys": ["localId"] },
        {
          "call": "getNearby",
          "args": { "lat": 52.0, "lng": 13.0, "radiusMeters": 300, "categories": ["hazards"] },
          "expect": { "items": [{ "kind": "hazard", "hazardType": "ice", "pending": true }] }
        },
        { "call": "getSyncStatus", "expect": { "pendingWrites": 1 } },
        { "call": "sync", "expect": { "submitted": 1, "pendingWrites": 0 } },
        {
          "mockLog": {
            "server": "main",
            "route": "POST /v1/hazard-reports",
            "count": 1,
            "bodyIncludes": { "type": "ice" },
            "signatureValid": true
          }
        },
        { "call": "sync", "expect": { "ok": true } },
        {
          "call": "getNearby",
          "args": { "lat": 52.0, "lng": 13.0, "radiusMeters": 300, "categories": ["hazards"] },
          "expect": { "items": [{ "kind": "hazard", "id": "hz-1", "hazardType": "ice", "pending": false }] }
        },
        { "call": "confirmReport", "args": { "reportId": "hz-1", "stillThere": true }, "expectKeys": ["localId"] },
        { "call": "sync", "expect": { "submitted": 1 } },
        {
          "mockLog": {
            "server": "main",
            "route": "POST /v1/hazard-reports/hz-1/confirmations",
            "count": 1,
            "bodyIncludes": { "kind": "stillThere" }
          }
        },
        {
          "call": "updatePosition",
          "args": { "lat": 52.52, "lng": 13.405 },
          "expect": { "changed": true, "tiles": ["871f1d488ffffff", "871f1d489ffffff", "871f1d48bffffff", "871f1d48dffffff", "871f1d4d4ffffff", "871f1d4d6ffffff", "871f1d4f2ffffff"] }
        },
        { "call": "updatePosition", "args": { "lat": 52.5201, "lng": 13.4051 }, "expect": { "changed": false } },
        {
          "call": "pollEvents",
          "expectSome": { "path": "events", "match": { "type": "syncCompleted" } }
        },
        { "call": "noSuchMethod", "expectError": "invalidArgument" },
        { "call": "getSpeedLimitAt", "args": { "lat": "north" }, "expectError": "invalidArgument" },
        { "call": "submitReport", "args": { "type": "dragons", "lat": 52.0, "lng": 13.0 }, "expectError": "invalidArgument" },
        { "call": "getNearby", "args": { "lat": 52.0, "lng": 13.0, "radiusMeters": 0 }, "expectError": "invalidArgument" },
        { "call": "close" },
        { "call": "getSyncStatus", "expectError": "closed" }
      ]
    },
    {
      "name": "a report survives a server that fails and goes out on a later sync",
      "servers": { "main": {} },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "mockFail": { "server": "main", "route": "POST /v1/hazard-reports", "status": 503, "times": 1 } },
        { "call": "submitReport", "args": { "type": "traffic", "lat": 52.0, "lng": 13.0 }, "expectKeys": ["localId"] },
        { "call": "sync", "expect": { "submitted": 0, "pendingWrites": 1 } },
        { "call": "sync", "expect": { "submitted": 1, "pendingWrites": 0 } }
      ]
    },
    {
      "name": "failover: one of the two configured servers is dead",
      "servers": { "main": {} },
      "options": {
        "nodes": ["http://127.0.0.1:9", "${main}"],
        "discovery": false,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        {
          "call": "getSpeedLimitAt",
          "args": { "lat": 52.0, "lng": 13.005 },
          "expect": { "value": 50 }
        },
        { "call": "getNetworkStatus", "expect": { "knownNodes": [{}, {}] } }
      ]
    },
    {
      "name": "cold start with only a seed: the directory brings the rest of the network",
      "servers": { "b": {}, "a": { "peers": ["${b}"] } },
      "options": {
        "discovery": true,
        "seeds": ["${a}"],
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        {
          "call": "getNetworkStatus",
          "expect": { "knownNodes": [{}, {}], "directoryGeneratedAt": "2027-01-01T00:00:00.000Z" }
        },
        { "mockLog": { "server": "a", "route": "GET /v1/network/directory", "count": 1 } },
        { "call": "getSpeedLimitAt", "args": { "lat": 52.0, "lng": 13.005 }, "expect": { "value": 50 } }
      ]
    },
    {
      "name": "a network with no reachable server is a valid state: reads work, sync says network",
      "servers": {},
      "options": {
        "discovery": true,
        "seeds": ["http://127.0.0.1:9"],
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "getSpeedLimitAt", "args": { "lat": 52.0, "lng": 13.005 }, "expect": null },
        { "call": "getNearby", "args": { "lat": 52.0, "lng": 13.0, "radiusMeters": 500 }, "expect": { "items": [] } },
        { "call": "sync", "expectError": "network" },
        { "call": "getSyncStatus", "expect": { "connection": "offline" } },
        { "call": "submitReport", "args": { "type": "traffic", "lat": 52.0, "lng": 13.0 }, "expectKeys": ["localId"] },
        { "call": "getSyncStatus", "expect": { "pendingWrites": 1 } }
      ]
    },
    {
      "name": "no credentials: sync says notConfigured",
      "servers": { "main": {} },
      "options": { "nodes": ["${main}"], "discovery": false },
      "steps": [{ "call": "sync", "expectError": "notConfigured" }]
    },
    {
      "name": "the camera namespace needs the host app's opt-in as well as the server",
      "servers": { "main": { "cameraNamespace": true } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNetworkStatus", "expect": { "cameraNamespaceEnabled": false, "configVersion": null } }
      ]
    },
    {
      "name": "a signed network configuration can switch the camera namespace off",
      "servers": { "main": { "cameraNamespace": true, "networkConfig": { "version": 3, "blitzerEnabled": false } } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "networkRootKey": "${main.rootKey}",
        "cameraNamespaceEnabled": true,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNetworkStatus", "expect": { "cameraNamespaceEnabled": false, "configVersion": 3 } }
      ]
    },
    {
      "name": "a network configuration signed with the wrong key is ignored",
      "servers": { "main": { "cameraNamespace": true, "networkConfig": { "version": 3, "blitzerEnabled": false }, "signWith": "impostor" } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "networkRootKey": "${main.rootKey}",
        "cameraNamespaceEnabled": true,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNetworkStatus", "expect": { "cameraNamespaceEnabled": true, "configVersion": null } }
      ]
    },
    {
      "name": "country policy: a zones level shows areas and never an individual camera",
      "servers": { "main": { "cameraNamespace": true, "cameraPolicy": { "defaultLevel": "zones" }, "cameraData": { "camera": true, "zone": true } } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "cameraNamespaceEnabled": true,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expect": { "items": [ { "kind": "cameraZone", "id": "zone-1", "cameraTypes": ["fixedSpeedCamera", "mobileSpeedCamera"], "distanceMeters": 0 } ] } },
        { "call": "getCameraPolicy", "expect": { "hostEnabled": true, "active": true, "maxLevel": "zones", "defaultLevel": "zones", "notice": { "version": 1 } } }
      ]
    },
    {
      "name": "country policy: a country at full shows individual cameras, a zones country its area",
      "servers": { "main": { "cameraNamespace": true, "cameraPolicy": { "defaultLevel": "off", "byCountry": { "DE": "full", "FR": "zones" } }, "cameraData": { "camera": true, "zone": true } } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "cameraNamespaceEnabled": true,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expectSome": { "path": "items", "match": { "kind": "camera", "id": "cam-1" } } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expectSome": { "path": "items", "match": { "kind": "cameraZone", "id": "zone-1" } } },
        { "call": "getCameraPolicy", "expect": { "maxLevel": "full", "defaultLevel": "off", "byCountry": { "DE": "full", "FR": "zones" } } }
      ]
    },
    {
      "name": "country policy: nothing shows until the host app switches cameras on",
      "servers": { "main": { "cameraNamespace": true, "cameraPolicy": { "defaultLevel": "full" }, "cameraData": { "camera": true, "zone": true } } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expect": { "items": [] } },
        { "call": "getCameraPolicy", "expect": { "hostEnabled": false, "active": false, "maxLevel": "full", "notice": { "text": { "de": "Hinweis (Mock)" } } } }
      ]
    },
    {
      "name": "country policy: a verified signed network policy can only tighten what the node claims",
      "servers": { "main": { "cameraNamespace": true, "cameraPolicy": { "defaultLevel": "off", "byCountry": { "DE": "full" } }, "cameraData": { "camera": true, "zone": true }, "networkConfig": { "version": 4, "blitzerEnabled": true, "cameraPolicyByCountry": { "DE": "off" } } } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "networkRootKey": "${main.rootKey}",
        "cameraNamespaceEnabled": true,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNetworkStatus", "expect": { "configVersion": 4 } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expect": { "items": [] } },
        { "call": "getCameraPolicy", "expect": { "maxLevel": "off", "active": false, "byCountry": { "DE": "off" } } }
      ]
    },
    {
      "name": "country policy: a stricter policy removes what was stored",
      "servers": { "main": { "cameraNamespace": true, "cameraPolicy": { "defaultLevel": "full" }, "cameraData": { "camera": true, "zone": true } } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "cameraNamespaceEnabled": true,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expectSome": { "path": "items", "match": { "kind": "camera", "id": "cam-1" } } },
        { "mockSet": { "server": "main", "config": { "cameraPolicy": { "defaultLevel": "full", "byCountry": { "DE": "zones" }, "version": "p2" }, "cameraData": { "camera": false, "zone": true } } } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expect": { "items": [ { "kind": "cameraZone", "id": "zone-1" } ] } },
        { "call": "getCameraPolicy", "expect": { "version": "p2", "byCountry": { "DE": "zones" } } }
      ]
    },
    {
      "name": "country policy: the emergency brake removes every camera locally",
      "servers": { "main": { "cameraNamespace": true, "cameraPolicy": { "defaultLevel": "full" }, "cameraData": { "camera": true, "zone": true } } },
      "options": {
        "nodes": ["${main}"],
        "discovery": false,
        "cameraNamespaceEnabled": true,
        "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" }
      },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" }, "expect": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expectSome": { "path": "items", "match": { "kind": "camera", "id": "cam-1" } } },
        { "mockSet": { "server": "main", "config": { "cameraNamespace": false, "cameraPolicy": { "namespaceEnabled": false, "defaultLevel": "full" }, "cameraData": { "camera": false, "zone": false } } } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getNearby", "args": { "lat": 52.52, "lng": 13.405, "radiusMeters": 500, "categories": ["cameras"] }, "expect": { "items": [] } },
        { "call": "getCameraPolicy", "expect": { "enabled": false, "active": false, "maxLevel": "off" } }
      ]
    },
    {
      "name": "report duration: the server's bounds, an own duration, and a server that takes none",
      "servers": {
        "main": { "reportExpiry": { "accident": { "defaultSeconds": 1800, "minSeconds": 300, "maxSeconds": 7200 } } }
      },
      "options": { "nodes": ["${main}"], "discovery": false, "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" } },
      "steps": [
        { "call": "getReportLimits", "args": { "type": "accident" }, "expect": { "supported": false } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "getReportLimits", "args": { "type": "accident" }, "expect": { "supported": true, "defaultSeconds": 1800, "minSeconds": 300, "maxSeconds": 7200 } },
        { "call": "getReportLimits", "args": { "type": "ice" }, "expect": { "supported": false, "defaultSeconds": 900 } },
        { "call": "submitReport", "args": { "type": "accident", "lat": 52.0, "lng": 13.0, "ttlSeconds": 3600 }, "expect": { "expiresInSeconds": 3600, "durationHonoured": true, "defaultSeconds": 1800 } },
        { "call": "submitReport", "args": { "type": "accident", "lat": 52.0, "lng": 13.0, "ttlSeconds": 60 }, "expectError": "ttlOutOfRange" },
        { "call": "submitReport", "args": { "type": "accident", "lat": 52.0, "lng": 13.0, "ttlSeconds": 99999 }, "expectError": "ttlOutOfRange" },
        { "call": "submitReport", "args": { "type": "ice", "lat": 52.0, "lng": 13.0, "ttlSeconds": 600 }, "expect": { "expiresInSeconds": null, "durationHonoured": false } },
        { "call": "getSyncStatus", "expect": { "pendingWrites": 2 } },
        { "call": "sync", "expect": { "submitted": 2, "pendingWrites": 0 } },
        {
          "mockLog": {
            "server": "main",
            "route": "POST /v1/hazard-reports",
            "count": 2,
            "bodyIncludes": { "type": "accident", "expiresInSeconds": 3600 },
            "signatureValid": true
          }
        }
      ]
    },
    {
      "name": "a limit for a stretch of road named by two points: queued offline, sent with a signature; the road is resolved by the server; wrong entries can be marked",
      "servers": { "main": { "communityCorrections": true } },
      "options": { "nodes": ["${main}"], "discovery": false, "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" } },
      "steps": [
        { "call": "setOfflineRegions", "args": { "mode": "all" } },
        { "call": "sync", "expect": { "ok": true } },
        { "call": "reportSpeedLimitInterval", "args": { "from": { "lat": 52.3, "lng": 13.2 }, "to": { "lat": 52.3, "lng": 13.2001 }, "value": 30, "unit": "kmh" }, "expectError": "intervalTooShort" },
        { "call": "reportSpeedLimitInterval", "args": { "from": { "lat": 52.3, "lng": 13.2 }, "to": { "lat": 52.3, "lng": 13.204 }, "value": 33, "unit": "kmh" }, "expectError": "invalidArgument" },
        { "call": "reportSpeedLimitInterval", "args": { "from": { "lat": 52.3, "lng": 13.2 }, "value": 30, "unit": "kmh" }, "expectError": "invalidArgument" },
        { "call": "reportSpeedLimitInterval", "args": { "from": { "lat": 52.3, "lng": 13.2 }, "to": { "lat": 52.3, "lng": 13.204 }, "value": 30, "unit": "kmh" }, "expect": { "state": "queued", "value": 30, "unit": "kmh" }, "expectKeys": ["segmentKey"] },
        { "call": "resolveRoadInterval", "args": { "from": { "lat": 52.3, "lng": 13.2 }, "to": { "lat": 52.3, "lng": 13.204 } }, "expect": { "lengthM": 300, "road": { "name": "Feldweg" }, "geometry": { "type": "LineString" } } },
        { "call": "resolveRoadInterval", "args": { "from": { "lat": 30.0, "lng": 13.2 }, "to": { "lat": 30.0, "lng": 13.204 } }, "expectError": "noRoadBetweenPoints" },
        { "call": "dataDefectsNear", "args": { "lat": 52.3, "lng": 13.2005 }, "expect": [ { "targetType": "speedLimitSegment", "reports": 1, "threshold": 3 } ] },
        { "call": "reportDataDefect", "args": { "targetType": "speedLimitSegment", "targetId": "defect-seg-1", "reason": "not_on_a_road" }, "expect": { "recorded": true, "reports": 2, "removed": false } },
        { "call": "getSyncStatus", "expect": { "pendingWrites": 1 } },
        { "call": "sync", "expect": { "submitted": 1, "pendingWrites": 0 } },
        { "mockLog": { "server": "main", "route": "POST /v1/speed-limit-intervals", "count": 1, "bodyIncludes": { "value": 30, "unit": "kmh" } } },
        { "mockLog": { "server": "main", "route": "POST /v1/data-defects", "count": 1, "bodyIncludes": { "targetType": "speedLimitSegment", "reason": "not_on_a_road" } } }
      ]
    },
    {
      "name": "offline area, automatic: nothing without a position, then the surroundings; lookups fall back online outside",
      "servers": { "main": { "secondTile": true } },
      "options": { "nodes": ["${main}"], "discovery": false, "credentials": { "type": "client", "clientId": "conformance", "clientSecret": "secret" } },
      "steps": [
        { "call": "getOfflineSettings", "expect": { "mode": "auto", "wifiOnly": true, "maxBytes": null } },
        { "call": "sync", "expect": { "ok": true, "needsLocation": true, "offlineFetchedTiles": 0 } },
        { "call": "getStoragePlan", "expect": { "mode": "auto", "needsLocation": true, "storedTiles": 0 } },
        { "call": "getCoverage", "args": { "lat": 52.52, "lng": 13.405 }, "expect": { "covered": false, "state": "outside" } },
        { "call": "updatePosition", "args": { "lat": 52.52, "lng": 13.405 } },
        { "call": "getCoverage", "args": { "lat": 52.52, "lng": 13.405 }, "expect": { "covered": false, "state": "wanted" } },
        { "call": "sync", "expect": { "ok": true, "needsLocation": false, "offlineFetchedTiles": 2 } },
        { "call": "getSpeedLimitAt", "args": { "lat": 52.52, "lng": 13.405 }, "expect": { "value": 30, "segmentId": "seg-berlin" } },
        { "call": "getCoverage", "args": { "lat": 52.52, "lng": 13.405 }, "expect": { "covered": true, "state": "stored", "usesNetwork": false } },
        { "call": "getStorageUsage", "expect": { "storedTiles": 2 } },
        { "call": "listOfflineRegions", "expectSome": { "path": "regions", "match": { "id": "DE-berlin", "country": "DE", "state": "complete" } } },
