{
  "name": "@trafficnetwork/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional bulk-import client that seeds a Trafficnetwork server's database from OpenStreetMap and other sources, over the server's public bulk-import API (Phase 3).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "generate:implicit-speeds": "tsx scripts/generate-implicit-speeds.mts",
    "report:quality": "tsx scripts/source-quality-report.mts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "h3-js": "^4.1.0",
    "pino": "^9.5.0",
    "saxes": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
