# Server this ingestion run talks to, and a client provisioned there with the
# bulk-import scope (operator runs, from server/: npm run create-client --
# --name "ingestion" --scope bulk-import — see server/README.md).
SERVER_URL=http://localhost:3000
CLIENT_ID=
CLIENT_SECRET=

# Where local progress/resume state lives — gitignored, and the ONLY thing
# protecting a resumed run from duplicating rows already accepted by the
# server (it has no dedup of its own). Never delete between runs.
STATE_DIR=./.ingestion-state

# Where downloaded source extracts are cached between runs — gitignored.
DOWNLOAD_DIR=./.ingestion-downloads

# Rows per bulk-import API call (server hard-caps at 5000).
BATCH_SIZE=2000

# Pause after every committed batch, in ms (0 = as fast as the server answers). A pacing floor for long imports.
BATCH_PACING_MS=0

# Abort when more rows than this were quarantined (invalid / rejected by the server) — stray bad rows are
# expected, hundreds mean a systematic problem. Rows are kept in quarantine.ndjson in STATE_DIR.
MAX_QUARANTINED=500

# Where osmium keeps its node-location index (≈16 B per node, randomly accessed — use an SSD for a continent).
# Default: next to the other osmium work files under DOWNLOAD_DIR.
# OSMIUM_INDEX_DIR=

HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_MS=500
HTTP_BACKOFF_MAX_MS=30000

LOG_LEVEL=info

# Only OSM is on by default.
OSM_ENABLED=true
HERE_ENABLED=false
TOMTOM_ENABLED=false
MOBILITHEK_ENABLED=false
AUTOBAHN_API_ENABLED=false

# Required only when the corresponding source above is enabled. No default:
# current HERE/TomTom free-tier pricing could not be confirmed from an
# authoritative current source (see ingestion/docs/sources.md) — set this
# from your own account/contract, not a guess.
# HERE_MONTHLY_CALL_LIMIT=
# TOMTOM_MONTHLY_CALL_LIMIT=
