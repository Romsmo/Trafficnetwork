{
  "name": "@trafficnetwork/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay/moderator server for the Trafficnetwork local-first traffic data network (Phase 1).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "start": "node dist/server.js",
    "db:migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "create-client": "tsx scripts/create-client.mts",
    "corrections": "tsx scripts/corrections.mts",
    "network:generate-root-key": "tsx scripts/network-generate-root-key.mts",
    "network:sign-config": "tsx scripts/network-sign-config.mts",
    "network:export-directory": "tsx scripts/network-export-directory.mts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "canonicalize": "^5.0.0",
    "close-with-grace": "^2.1.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "h3-js": "^4.1.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4",
    "ws": "^8.18.0"
  }
}
