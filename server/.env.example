# Postgres connection string (Neon pooled connection recommended for the app;
# use the unpooled/direct connection string for running migrations).
#
# Self-hosting via docker-compose.yml instead? Leave DATABASE_URL unset and
# fill in POSTGRES_USER/PASSWORD/DB below — the compose file builds
# DATABASE_URL from those automatically, pointed at its own postgres service.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Only used by docker-compose.yml's self-hosted postgres service (ignored if
# you set DATABASE_URL to an external database like Neon instead).
POSTGRES_USER=trafficnetwork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trafficnetwork

# Secret used to sign client-credential JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Global kill switch for the speed-camera namespace (fixedSpeedCamera,
# mobileSpeedCamera, trailerCamera, redLightCamera, distanceControl).
# Must stay "false" in production until the operator has taken legal advice
# on §23 Abs. 1b StVO operator risk (see docs/concept.md section 8).
SPEED_CAMERA_NAMESPACE_ENABLED=false

# Event log retention windows (days). Dynamic events (hazard report
# lifecycle) expire fast on their own; static events are kept longer
# because their volume is low and clients may be offline for a while.
EVENT_LOG_RETENTION_DAYS_DYNAMIC=3
EVENT_LOG_RETENTION_DAYS_STATIC=30

# Moderation gate tuning.
REPORT_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_WINDOW_MINUTES=10
DUPLICATE_MERGE_RADIUS_METERS=500
SPEED_KMH_MIN=0
SPEED_KMH_MAX=300

# How long a hazard report stays active before it expires, per band (docs/concept.md
# section 3.2); a "still there" confirmation restarts the clock. Short: mobile/trailer
# cameras, red-light and distance reports. Medium: traffic, ice, accident, breakdown,
# obstacle. Construction: roadworks, in days. Fixed cameras never expire.
HAZARD_EXPIRY_SHORT_MINUTES=12
HAZARD_EXPIRY_MEDIUM_MINUTES=25
HAZARD_EXPIRY_CONSTRUCTION_DAYS=7

# Distinct-reporter "this fixed camera is gone" votes needed before it's marked removed.
CAMERA_REMOVAL_THRESHOLD=3

# Auth.
JWT_TTL_SECONDS=3600

# Point speed-limit lookup: how far a queried point may be from the nearest
# stored segment before we treat it as "no data" rather than guessing.
SPEED_LIMIT_LOOKUP_MAX_DISTANCE_METERS=200

# H3 resolution used for regionTile (see docs/prompt-phase1-server.md section 2.1).
REGION_TILE_H3_RESOLUTION=7

# H3 resolution that partitions the static-data packages (client-lib P2.0). 4 gives packages of
# a few MB at Europe density (the former default 2 gave hundreds of MB) — decided by the operator
# 2026-09-25. EVERY NODE OF A NETWORK MUST USE THE SAME VALUE (tile ids and packages would be
# incompatible otherwise), and changing it later makes every device re-download everything.
# It is published in GET /v1/config and in every manifest ("partitionResolution").
STATIC_DATA_PARTITION_H3_RESOLUTION=4

# Anonymous device registration (client-lib P2.0): max devices one app key may
# register per rolling day.
DEVICE_REGISTRATION_RATE_LIMIT_MAX_PER_DAY=50

# Self-hosting & federation (Phase F). false = isolated single server, exactly
# today's behavior — nothing below this line is required unless you're
# joining a federated network. See docs/federation.md and server/docs/threat-model.md.
FEDERATION_ENABLED=false

# The network's root public key (Ed25519, raw base64url) — needed to verify a
# signed network config. Leave unset for a non-federating single server.
# NETWORK_ROOT_PUBLIC_KEY=

# Path to a root-signed network config JSON file (produced offline by
# scripts/network-sign-config.mts). If set, NETWORK_ROOT_PUBLIC_KEY must be
# set too, and the server refuses to start if the file doesn't verify.
# NETWORK_CONFIG_PATH=

# Federation protocol (F-S3) — only relevant when FEDERATION_ENABLED=true.
#
# This server's own externally-reachable https:// base URL, told to peers on
# join/heartbeat so they know how to reach back. Required whenever
# FEDERATION_ENABLED=true (the server refuses to start without it).
# FEDERATION_PUBLIC_ADDRESS=https://your-server.example
#
# Comma-separated https:// base URLs of seed servers to join on startup.
# Optional even when federating (a network's first server has no seed to join).
# FEDERATION_SEEDS=https://seed1.example,https://seed2.example
FEDERATION_HEARTBEAT_INTERVAL_SECONDS=60
FEDERATION_ANTI_ENTROPY_INTERVAL_SECONDS=300
FEDERATION_ANTI_ENTROPY_PAGE_SIZE=200
FEDERATION_EVENT_MAX_AGE_HOURS=72
FEDERATION_PEER_TIMEOUT_MS=5000
# POST /v1/federation/events answers 503 + Retry-After once this many pushes are being
# processed at the same time by this process (a concurrency cap, not a rate limit).
FEDERATION_OVERLOAD_MAX_CONCURRENT_PUSHES=20

# Peer reputation (F-S4, docs/federation-protocol.md section 4.3). Measured by this
# server's own health checks of a peer, never self-reported. A new peer starts in
# probation and becomes "active" after this many hours AND successful health checks;
# "trusted" needs the longer window and more checks. Consecutive failures demote a
# peer back to probation. The directory lists at most this share of probation peers.
REPUTATION_PROBATION_MIN_HOURS=24
REPUTATION_MIN_SUCCESSFUL_HEALTH_CHECKS=5
REPUTATION_TRUSTED_MIN_HOURS=168
REPUTATION_TRUSTED_MIN_SUCCESSFUL_HEALTH_CHECKS=50
REPUTATION_DEMOTE_AFTER_CONSECUTIVE_FAILURES=5
REPUTATION_DIRECTORY_PROBATION_MAX_SHARE=0.5

# Community speed-limit corrections (add-on K-A, docs/speed-limit-corrections.md).
# Users can propose a corrected speed limit; it overlays the imported value once
# enough distinct devices agree. The imported value is never changed.
#
# Master switch. false: reads serve the imported values again, the correction
# endpoints and the federation vote stream don't exist, pushed votes are ignored.
# Stored votes are kept, so switching back on restores them.
COMMUNITY_CORRECTIONS_ENABLED=true
# Net confirmations (distinct supporting devices minus distinct denying devices)
# a proposed value needs before it overrides the import. The safety knob: raise
# it if you see abuse. Keep it identical to the servers you federate with.
COMMUNITY_CORRECTIONS_CONFIRMATIONS_REQUIRED=3
# Plausible range per unit, in the segment's own unit (a correction never
# converts), and the step a value must be a multiple of (posted limits are
# multiples of 5 almost everywhere; 1 disables the step check).
COMMUNITY_CORRECTIONS_KMH_MIN=5
COMMUNITY_CORRECTIONS_KMH_MAX=150
COMMUNITY_CORRECTIONS_MPH_MIN=5
COMMUNITY_CORRECTIONS_MPH_MAX=85
COMMUNITY_CORRECTIONS_VALUE_STEP=5
# Per calling client: proposals, confirmations and denials together. Deliberately
# stricter than REPORT_RATE_LIMIT_* (a correction is a durable, safety-relevant claim).
COMMUNITY_CORRECTIONS_RATE_LIMIT_MAX=5
COMMUNITY_CORRECTIONS_RATE_LIMIT_WINDOW_MINUTES=60

# Europe-scale storage and delivery (add-on E-B, docs/europe-scale.md).
#
# Static data is delivered as pre-built, compressed, content-addressed package
# files (one per H3 tile) instead of being computed per request. Built in the
# background after static data changes; `npm run static-packages -- build` does
# the same by hand (it must see the same STATIC_PACKAGES_DIR).
# Where the files live (in Docker: a volume, set by the image). Both gzip and
# brotli copies are kept: about half a byte on disk per byte of package JSON
# (measured, docs/operating.md), plus room for files replaced by a rebuild.
# STATIC_PACKAGES_DIR=./data/static-packages
STATIC_PACKAGES_WORKER_ENABLED=true
# The worker waits until static data has been quiet this long before rebuilding
# the tiles a write touched (a bulk import must not trigger a rebuild per batch),
# but never more than MAX_WAIT seconds after the first unbuilt change.
STATIC_PACKAGES_DEBOUNCE_SECONDS=30
STATIC_PACKAGES_MAX_WAIT_SECONDS=900
# Up to this many static rows the first request builds the packages itself;
# above it requests get 503 + Retry-After until the worker has finished.
STATIC_PACKAGES_INLINE_BUILD_MAX_ROWS=200000
# Rows per cursor fetch while a tile is streamed to disk (memory bound), and the
# compression effort of the stored files (built once, downloaded many times).
STATIC_PACKAGES_PAGE_ROWS=5000
STATIC_PACKAGES_GZIP_LEVEL=9
STATIC_PACKAGES_BROTLI_QUALITY=9
# How long a replaced package file is kept for clients that are mid-download.
STATIC_PACKAGES_KEEP_MINUTES=120
# true: the content-addressed package URLs (/v1/static-data/packages/<tile>/<hash>)
# need no Authorization header, so a reverse proxy or CDN can cache them. The data
# is public OSM data, but anyone could then download it from you: off by default.
STATIC_PACKAGES_PUBLIC=false
# GET /v1/snapshot with static data loads every static row into memory; above this
# many rows it answers 413 and points at the manifest/packages (0 = no check).
SNAPSHOT_STATIC_MAX_ROWS=1000000
# Rows accepted per POST /v1/bulk-import/* call.
BULK_IMPORT_MAX_ROWS=5000

# "Currently online" counter (add-on O-A) — GET /v1/stats/online, public.
# Numbers only, kept in process memory; nothing about a person is stored or
# logged. See docs/api.md ("GET /v1/stats/online") for what counts as online.
# false: the endpoint answers { "enabled": false } and nothing is tracked.
ONLINE_COUNTER_ENABLED=true
# A client that made a sync or write request within this window counts as
# online (open WebSocket connections count while open). 0 = connections only.
ONLINE_WINDOW_SECONDS=300
# Below this many, the endpoint says "fewer than N" instead of the exact
# number ("1 online" would be a statement about one person). 0 = never mask.
ONLINE_MIN_DISPLAY_THRESHOLD=5
# How long a computed answer is reused (also sent as Cache-Control max-age).
ONLINE_CACHE_SECONDS=10
# A federated peer's reported figure stops counting towards the estimated
# network total when its last heartbeat is older than this.
ONLINE_PEER_STALE_SECONDS=300
# Upper bound on distinct clients remembered for the window (memory limit).
ONLINE_MAX_TRACKED=100000


# --- Web UI (docs/web-ui.md) ---
# The node serves a small web page at "/" (map, report a hazard, how-to-connect, about). Off = API only.
WEB_UI_ENABLED=true
# Link shown in the footer and on the About page.
PROJECT_REPO_URL=https://github.com/Romsmo/Trafficnetwork
# Map background for the web UI: raster tiles, {z}/{x}/{y} placeholders, no API keys in the URL (visitors can see it).
# The default is OpenStreetMap's public tile server — fine for a small node, NOT meant for heavy traffic (see its
# tile usage policy, https://operations.osmfoundation.org/policies/tiles/); use your own or a commercial tile
# service for a busy node. Unset/empty = that default; "none" = no map background at all.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION_TEXT=© OpenStreetMap contributors
MAP_TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# Behind a reverse proxy (Caddy/nginx/Apache): tell the server which proxies to trust so per-IP limits see the real
# visitor. "1" = one proxy hop; or a comma-separated list of proxy IPs/CIDRs; "true" = trust every hop (only if the
# server is reachable ONLY through the proxy). Leave empty when clients connect directly.
TRUST_PROXY=
# Request logs without coordinates (query string) and client addresses. Turn off only to debug.
LOG_PRIVACY_MODE=true
# Highest zoom level of the tile source above (1-22).
MAP_TILE_MAX_ZOOM=19

# Anonymous web sessions (POST /v1/web/session) and what they may do — see docs/web-ui.md, "How the page talks to the node".
# Lifetime of a session in seconds (60-3600); the page renews it shortly before it expires.
WEB_SESSION_TTL_SECONDS=900
# Sessions one client IP may create per minute.
WEB_SESSION_MINT_LIMIT_PER_MINUTE=20
# Reports and confirmations: per session (within REPORT_RATE_LIMIT_WINDOW_MINUTES), per client IP and hour, and a
# circuit breaker per hour for all web sessions of this node together.
WEB_REPORT_LIMIT_PER_SESSION=3
WEB_REPORT_LIMIT_PER_IP_PER_HOUR=10
WEB_REPORT_LIMIT_NODE_PER_HOUR=300
# Reads per client IP and minute; the road-segment query behind the speed-limit layer is heavier and has its own budget.
WEB_READ_LIMIT_PER_IP_PER_MINUTE=120
WEB_HEAVY_READ_LIMIT_PER_IP_PER_MINUTE=30
# Largest area (radius in metres around the map centre) the speed-limit layer / the hazard list may load (max 50000).
WEB_MAX_SEGMENT_RADIUS_M=1500
WEB_MAX_HAZARD_RADIUS_M=25000
# Live-update (WebSocket) tile subscriptions one web connection may hold.
WEB_WS_MAX_TILES_PER_CONNECTION=60
