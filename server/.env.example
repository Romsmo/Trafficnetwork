# Postgres connection string (Neon pooled connection recommended for the app;
# use the unpooled/direct connection string for running migrations).
#
# Self-hosting via docker-compose.yml instead? Leave DATABASE_URL unset and
# fill in POSTGRES_USER/PASSWORD/DB below — the compose file builds
# DATABASE_URL from those automatically, pointed at its own postgres service.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Only used by docker-compose.yml's self-hosted postgres service (ignored if
# you set DATABASE_URL to an external database like Neon instead).
POSTGRES_USER=trafficnetwork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trafficnetwork

# Secret used to sign client-credential JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Global kill switch for the speed-camera namespace (fixedSpeedCamera,
# mobileSpeedCamera, trailerCamera, redLightCamera, distanceControl).
# Must stay "false" in production until the operator has taken legal advice
# on §23 Abs. 1b StVO operator risk (see docs/concept.md section 8).
SPEED_CAMERA_NAMESPACE_ENABLED=false

# Event log retention windows (days). Dynamic events (hazard report
# lifecycle) expire fast on their own; static events are kept longer
# because their volume is low and clients may be offline for a while.
EVENT_LOG_RETENTION_DAYS_DYNAMIC=3
EVENT_LOG_RETENTION_DAYS_STATIC=30

# Moderation gate tuning.
REPORT_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_WINDOW_MINUTES=10
DUPLICATE_MERGE_RADIUS_METERS=500
SPEED_KMH_MIN=0
SPEED_KMH_MAX=300

# Distinct-reporter "this fixed camera is gone" votes needed before it's marked removed.
CAMERA_REMOVAL_THRESHOLD=3

# Auth.
JWT_TTL_SECONDS=3600

# Point speed-limit lookup: how far a queried point may be from the nearest
# stored segment before we treat it as "no data" rather than guessing.
SPEED_LIMIT_LOOKUP_MAX_DISTANCE_METERS=200

# H3 resolution used for regionTile (see docs/prompt-phase1-server.md section 2.1).
REGION_TILE_H3_RESOLUTION=7

# Coarse H3 resolution for the static-data partition/manifest endpoints (client-lib P2.0).
STATIC_DATA_PARTITION_H3_RESOLUTION=2

# Anonymous device registration (client-lib P2.0): max devices one app key may
# register per rolling day.
DEVICE_REGISTRATION_RATE_LIMIT_MAX_PER_DAY=50

# Self-hosting & federation (Phase F). false = isolated single server, exactly
# today's behavior — nothing below this line is required unless you're
# joining a federated network. See docs/federation.md and server/docs/threat-model.md.
FEDERATION_ENABLED=false

# The network's root public key (Ed25519, raw base64url) — needed to verify a
# signed network config. Leave unset for a non-federating single server.
# NETWORK_ROOT_PUBLIC_KEY=

# Path to a root-signed network config JSON file (produced offline by
# scripts/network-sign-config.mts). If set, NETWORK_ROOT_PUBLIC_KEY must be
# set too, and the server refuses to start if the file doesn't verify.
# NETWORK_CONFIG_PATH=

# Federation protocol (F-S3) — only relevant when FEDERATION_ENABLED=true.
#
# This server's own externally-reachable https:// base URL, told to peers on
# join/heartbeat so they know how to reach back. Required whenever
# FEDERATION_ENABLED=true (the server refuses to start without it).
# FEDERATION_PUBLIC_ADDRESS=https://your-server.example
#
# Comma-separated https:// base URLs of seed servers to join on startup.
# Optional even when federating (a network's first server has no seed to join).
# FEDERATION_SEEDS=https://seed1.example,https://seed2.example
FEDERATION_HEARTBEAT_INTERVAL_SECONDS=60
FEDERATION_ANTI_ENTROPY_INTERVAL_SECONDS=300
FEDERATION_ANTI_ENTROPY_PAGE_SIZE=200
FEDERATION_EVENT_MAX_AGE_HOURS=72
FEDERATION_PEER_TIMEOUT_MS=5000

# Community speed-limit corrections (add-on K-A, docs/speed-limit-corrections.md).
# Users can propose a corrected speed limit; it overlays the imported value once
# enough distinct devices agree. The imported value is never changed.
#
# Master switch. false: reads serve the imported values again, the correction
# endpoints and the federation vote stream don't exist, pushed votes are ignored.
# Stored votes are kept, so switching back on restores them.
COMMUNITY_CORRECTIONS_ENABLED=true
# Net confirmations (distinct supporting devices minus distinct denying devices)
# a proposed value needs before it overrides the import. The safety knob: raise
# it if you see abuse. Keep it identical to the servers you federate with.
COMMUNITY_CORRECTIONS_CONFIRMATIONS_REQUIRED=3
# Plausible range per unit, in the segment's own unit (a correction never
# converts), and the step a value must be a multiple of (posted limits are
# multiples of 5 almost everywhere; 1 disables the step check).
COMMUNITY_CORRECTIONS_KMH_MIN=5
COMMUNITY_CORRECTIONS_KMH_MAX=150
COMMUNITY_CORRECTIONS_MPH_MIN=5
COMMUNITY_CORRECTIONS_MPH_MAX=85
COMMUNITY_CORRECTIONS_VALUE_STEP=5
# Per calling client: proposals, confirmations and denials together. Deliberately
# stricter than REPORT_RATE_LIMIT_* (a correction is a durable, safety-relevant claim).
COMMUNITY_CORRECTIONS_RATE_LIMIT_MAX=5
COMMUNITY_CORRECTIONS_RATE_LIMIT_WINDOW_MINUTES=60

# "Currently online" counter (add-on O-A) — GET /v1/stats/online, public.
# Numbers only, kept in process memory; nothing about a person is stored or
# logged. See docs/api.md ("GET /v1/stats/online") for what counts as online.
# false: the endpoint answers { "enabled": false } and nothing is tracked.
ONLINE_COUNTER_ENABLED=true
# A client that made a sync or write request within this window counts as
# online (open WebSocket connections count while open). 0 = connections only.
ONLINE_WINDOW_SECONDS=300
# Below this many, the endpoint says "fewer than N" instead of the exact
# number ("1 online" would be a statement about one person). 0 = never mask.
ONLINE_MIN_DISPLAY_THRESHOLD=5
# How long a computed answer is reused (also sent as Cache-Control max-age).
ONLINE_CACHE_SECONDS=10
# A federated peer's reported figure stops counting towards the estimated
# network total when its last heartbeat is older than this.
ONLINE_PEER_STALE_SECONDS=300
# Upper bound on distinct clients remembered for the window (memory limit).
ONLINE_MAX_TRACKED=100000
