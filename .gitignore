# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Env / Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs ---
*.log
logs/

# --- Node ---
node_modules/
dist/
build/
.npm/
npm-debug.log*
yarn-error.log*
pnpm-lock.yaml.bak

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# --- Go ---
bin/
*.test

# --- Java / Kotlin ---
target/
*.class
.gradle/

# --- Rust ---
# Unanchored (not /target/) — this is a monorepo, Rust crates can live in any
# subdirectory (e.g. client-lib/), not just the repo root. Cargo.lock itself
# is intentionally NOT ignored here: client-lib is consumed as prebuilt
# per-platform binding artifacts (AAR, XCFramework, npm, wheel, wasm), never
# as a source Cargo dependency of some other Rust project, so the usual
# "libraries shouldn't commit their lockfile" advice doesn't apply — what
# matters here is reproducible builds of *our own* release artifacts.
target/

# --- Databases / local data ---
*.sqlite
*.sqlite3
*.db
data/

# --- Ingestion local state / downloaded extracts (not tests/fixtures/*.osm.pbf, those are checked in) ---
ingestion/.ingestion-state/
ingestion/.ingestion-downloads/

# --- Coverage / test output ---
coverage/
.nyc_output/

# --- Docker ---
*.override.yml

# --- Playwright (server/e2e) ---
test-results/
playwright-report/

# --- client-lib (Rust) ---
# cbindgen-generated C header — regenerated on demand/in CI from src/lib.rs,
# never hand-edited, so not worth tracking (see bindings/c-abi/cbindgen.toml).
client-lib/bindings/c-abi/trafficnetwork.h
# wasm-pack output (`wasm-pack build --out-dir pkg`) — a build artifact, rebuilt by CI.
client-lib/bindings/wasm/pkg/
client-lib/bindings/kotlin/*/generated/
client-lib/bindings/kotlin/*/build/
client-lib/bindings/kotlin/*/.gradle/
client-lib/bindings/kotlin/android/src/main/jniLibs/
client-lib/bindings/kotlin/*/.kotlin/
